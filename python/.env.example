# Copy to ".env" next to pp_client.py and fill in. NEVER commit the real .env.
# Keep the file readable only by the account that runs the job (Linux: chmod 600 .env).
SAP_URL=https://<host>:<https-port>/sap/zpp/analytics
SAP_CLIENT=<client>
SAP_USER=<technical user>
SAP_PASSWORD=
# 1 = check the server certificate (keep 1 in production). 0 = skip the check (tests only)
SAP_VERIFY_SSL=1
# only if the certificate comes from an internal company CA: path to the root certificate (.pem)
SAP_CA_BUNDLE=
# the client refuses plain http:// unless this is 1 (development tests only)
SAP_ALLOW_HTTP=0
# optional, comma separated plants. Empty = all plants
SAP_PLANTS=
# where cache, logs and output go. Empty = folder "work" next to the script
WORK_DIR=
# 1 = keep the result files in <WORK_DIR>/out after the upload (default 0 = delete them; SAP holds the results)
PP_KEEP_OUT=0
